# Server-only values. Never commit real secrets.
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
OWNER_EMAIL=
# Optional stable identity pin, after the owner's first verified sign-in.
OWNER_USER_ID=
# Generate a separate 32-byte base64 key; keep it stable while outbox records exist.
MAIL_ENCRYPTION_KEY=
MAIL_MODE=preview
RESEND_API_KEY=
MAIL_FROM=
ADMIN_NOTIFY_EMAIL=

# Operational platform: generate a separate server-only key via your host's secret manager.
# Live issuance fails closed when this is missing. Do not reuse an auth/mail secret.
CREDENTIAL_SIGNING_SECRET=
MANUAL_PAYMENTS_ENABLED=false
JOURNAL_MIN_REVIEWS=2
JOURNAL_PUBLICATION_LICENCE=

# Hosted Stripe Checkout and signed webhook integration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# LinkedIn author must explicitly authorise the app with eligible permissions.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=202606
SITE_URL=

# Public-source guide always works. External model generation is opt-in.
AI_GENERATION_ENABLED=false
AI_GATEWAY_MODEL=
AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN is supplied by Vercel at runtime; never commit a copied token.

# Local development only; ignored by production/VERCEL. See docs/LOCAL-DEVELOPMENT.md.
STANAIC_LOCAL_DB=
